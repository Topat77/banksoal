rules_version = '2';

// =====================================================
//  ATURAN KEAMANAN DATABASE — Bank Soal
//
//  Ditempel di Firebase Console → Firestore Database → Rules → Publish.
//  Aturan ini yang beneran ngunci data: walau orang luar (atau santri)
//  berhasil masuk pakai akun Google, mereka nggak bisa baca apa pun
//  sebelum disetujui admin (TU).
//
//  Salinan aturan ini dalam bentuk JavaScript ada di js/aturan.js
//  (dipakai mode coba). Kalau ngubah di sini, ubah di sana juga.
// =====================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Email Google admin (TU) yang pertama (huruf kecil semua).
    // Sama dengan "adminAwal" di js/konfig.js.
    function emailAdminAwal() {
      return ['topatvanjava@gmail.com'];
    }

    function masuk() {
      return request.auth != null;
    }
    function jalurProfil() {
      return /databases/$(database)/documents/pengguna/$(request.auth.uid);
    }
    function aktif() {
      return masuk() && exists(jalurProfil())
        && get(jalurProfil()).data.peran in ['ustadz', 'kurikulum'];
    }
    function kurikulum() {
      return aktif() && get(jalurProfil()).data.peran == 'kurikulum';
    }
    function pengampu(idMapel) {
      return request.auth.uid in get(/databases/$(database)/documents/mapel/$(idMapel)).data.pengampu;
    }
    // grup = mapel yang sama di jenjang & tingkat yang sama (misal B. Indonesia 7A1, 7A2, 7B1, 7B2)
    function dataGrup(idGrup) {
      return get(/databases/$(database)/documents/grup/$(idGrup)).data;
    }
    function anggotaGrup(idGrup) {
      return request.auth.uid in dataGrup(idGrup).pengampu;
    }
    function koordinatorGrup(idGrup) {
      return dataGrup(idGrup).get('koordinator', null) == request.auth.uid;
    }
    // pengampu kelas lain yang satu grup dengan mapel ini
    function segrup(idMapel) {
      return anggotaGrup(get(/databases/$(database)/documents/mapel/$(idMapel)).data.grup);
    }

    // ---------- validasi isi dokumen ----------
    // Biar akun guru yang disalahgunakan nggak bisa ngisi kolom sembarangan
    // atau bikin dokumen kebesaran. Batasnya sengaja longgar.
    function isi() {
      return request.resource.data;
    }
    // dokumen baru: semua kolom harus dikenal. Ubah: cuma kolom yang BERUBAH yang dicek,
    // jadi dokumen lama yang punya kolom versi dulu tetap bisa diedit.
    function kolomDikenal(daftar) {
      return resource == null
        ? isi().keys().hasOnly(daftar)
        : isi().diff(resource.data).affectedKeys().hasOnly(daftar);
    }
    // kolom yang nggak boleh berubah setelah dibuat (kalau dulu belum ada, boleh diisi)
    function tetap(k) {
      return resource == null || !(k in resource.data)
        || (k in isi() && isi()[k] == resource.data[k]);
    }
    function teks(k, maks) {
      return !(k in isi()) || (isi()[k] is string && isi()[k].size() <= maks);
    }
    function teksAtauKosong(k, maks) {
      return !(k in isi()) || isi()[k] == null || (isi()[k] is string && isi()[k].size() <= maks);
    }
    function daftar(k, maks) {
      return !(k in isi()) || (isi()[k] is list && isi()[k].size() <= maks);
    }
    function peta(k, maks) {
      return !(k in isi()) || isi()[k] == null || (isi()[k] is map && isi()[k].size() <= maks);
    }
    function angka(k) {
      return !(k in isi()) || isi()[k] is number;
    }
    function yaTidak(k) {
      return !(k in isi()) || isi()[k] is bool;
    }
    function semesterTetap() {
      return teks('semester', 20) && teks('tahun', 20) && tetap('semester') && tetap('tahun') && tetap('dibuat')
        && angka('dibuat') && angka('diubah');
    }
    function modulValid() {
      return kolomDikenal(['semester', 'tahun', 'judul', 'catatan', 'link', 'pemilik', 'namaPemilik',
          'dibagikan', 'pertemuan', 'bacaan', 'soal', 'terkait', 'lanjutanDari', 'dibuat', 'diubah'])
        && semesterTetap()
        && teks('judul', 200) && teks('catatan', 5000) && teks('link', 500) && teks('namaPemilik', 100)
        && yaTidak('dibagikan') && teksAtauKosong('lanjutanDari', 100)
        && daftar('pertemuan', 100) && daftar('bacaan', 50) && daftar('soal', 500) && daftar('terkait', 50);
    }
    function sumatifValid() {
      return kolomDikenal(['semester', 'tahun', 'nama', 'pelaksanaan', 'pemilik', 'namaPemilik',
          'dibagikan', 'butir', 'disalinDari', 'dibuat', 'diubah'])
        && semesterTetap()
        && teks('nama', 200) && teks('pelaksanaan', 200) && teks('namaPemilik', 100)
        && yaTidak('dibagikan') && daftar('butir', 200) && peta('disalinDari', 5);
    }
    // UAS yang ditulis koordinator (TU nggak dibatasi)
    function uasValid() {
      return kolomDikenal(['semester', 'tahun', 'nama', 'pelaksanaan', 'status', 'butir',
          'dibuat', 'diubah', 'diubahOleh', 'namaPengubah', 'diajukan'])
        && semesterTetap()
        && teks('nama', 200) && teks('pelaksanaan', 200) && teks('namaPengubah', 100)
        && isi().diubahOleh == request.auth.uid
        && daftar('butir', 200) && angka('diajukan');
    }
    function usulanValid() {
      return kolomDikenal(['semester', 'tahun', 'modulId', 'soalId', 'salinan', 'catatan',
          'pemilik', 'namaPemilik', 'dibuat'])
        && semesterTetap()
        && teks('modulId', 100) && teks('soalId', 100) && teks('catatan', 2000) && teks('namaPemilik', 100)
        && peta('salinan', 10);
    }
    // lembar nilai: kolom nilainya dinamis, jadi cuma dicek bentuk & ukurannya
    function nilaiValid() {
      return semesterTetap()
        && daftar('kolom', 60) && peta('nilai', 300) && peta('hadir', 300)
        && teks('namaPengubah', 100);
    }
    // kolom yang berubah (atau dokumen baru)
    function berubah(k) {
      return resource == null || isi().diff(resource.data).affectedKeys().hasAny([k]);
    }
    // profil akun: cuma kolom yang dipakai aplikasi. Ukuran cuma dicek kalau kolomnya berubah,
    // jadi profil lama tetap bisa di-update (misal waktu nyatat terakhirMasuk).
    function profilValid() {
      return kolomDikenal(['nama', 'email', 'foto', 'peran', 'sapaan', 'nip',
          'dibuat', 'terakhirMasuk', 'diubah', 'diubahOleh'])
        && (!berubah('nama') || (isi().nama is string && isi().nama.size() <= 100))
        && (!berubah('nip') || teksAtauKosong('nip', 30))
        && (!berubah('foto') || teks('foto', 2000));
    }

    // ---------- akun ----------
    match /pengguna/{uid} {
      allow read: if masuk() && (request.auth.uid == uid || kurikulum());

      // daftar pertama kali: selalu "menunggu", kecuali email admin awal
      // sapaan & NIP cuma boleh diisi admin, jadi waktu daftar nggak boleh ada
      allow create: if masuk() && request.auth.uid == uid
        && profilValid()
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.get('sapaan', null) == null
        && request.resource.data.get('nip', null) == null
        && (request.resource.data.peran == 'menunggu'
            || (request.resource.data.peran == 'kurikulum'
                && request.auth.token.email_verified == true
                && request.auth.token.email in emailAdminAwal()));

      // ubah profil sendiri boleh, tapi nggak boleh ngubah peran, email, sapaan, & NIP sendiri
      // (sapaan ustadz/ustadzah nentuin kelas putra/putri yang boleh diajar, jadi diatur admin).
      // Admin boleh ngubah akun siapa pun (setujui, tolak, nonaktifkan).
      allow update: if masuk() && profilValid() && (
        (request.auth.uid == uid
          && request.resource.data.peran == resource.data.peran
          && request.resource.data.email == resource.data.email
          && request.resource.data.get('sapaan', null) == resource.data.get('sapaan', null)
          && request.resource.data.get('nip', null) == resource.data.get('nip', null))
        || kurikulum());

      allow delete: if kurikulum();
    }

    // ---------- pengaturan (lembaga: nama & lama ujian; bobot: bobot nilai per jenis mapel) ----------
    match /pengaturan/{id} {
      allow read: if aktif();
      allow write: if kurikulum();
    }

    // ---------- kelas ----------
    // daftar pengampu semua mapel di satu kelas (misal Paket B 7A1).
    // Diperbarui otomatis dari perangkat admin; dipakai aturan santri di bawah.
    match /kelas/{idKelas} {
      allow read: if aktif();
      allow write: if kurikulum();
    }

    // ---------- santri ----------
    // admin lihat semua; ustadz cuma santri di kelas yang dia ajar.
    // Yang ngisi, ngubah, ngehapus cuma admin.
    match /santri/{id} {
      allow read: if aktif() && (
        kurikulum()
        || request.auth.uid in get(/databases/$(database)/documents/kelas/$(resource.data.kelasId)).data.pengampu);
      allow write: if kurikulum();
    }

    // ---------- mapel ----------
    match /mapel/{idMapel} {
      allow read: if aktif();
      allow write: if kurikulum();

      // modul: pemiliknya + kurikulum selalu bisa lihat;
      // pengampu lain mapel ini, dan pengampu kelas lain di grupnya,
      // bisa lihat kalau modulnya dibagikan
      // (admin boleh BIKIN atas nama guru, buat mulihin dari cadangan; ngubah tetap cuma pemiliknya)
      match /modul/{id} {
        allow read: if aktif() && (
          kurikulum()
          || resource.data.pemilik == request.auth.uid
          || (resource.data.dibagikan == true && (pengampu(idMapel) || segrup(idMapel))));
        allow create: if aktif()
          && ((request.resource.data.pemilik == request.auth.uid && pengampu(idMapel)) || kurikulum())
          && modulValid();
        allow update: if aktif()
          && resource.data.pemilik == request.auth.uid
          && request.resource.data.pemilik == request.auth.uid
          && modulValid();
        allow delete: if aktif()
          && (resource.data.pemilik == request.auth.uid || kurikulum());
      }

      // lembar nilai satu semester: diisi pengampu mapel ini aja;
      // admin cuma bisa lihat (buat pantauan dan rapor), dan bikin lembar yang hilang dari cadangan
      match /nilai/{id} {
        allow read: if aktif() && (kurikulum() || pengampu(idMapel));
        allow create: if aktif() && (pengampu(idMapel) || kurikulum()) && nilaiValid();
        allow update: if aktif() && pengampu(idMapel) && nilaiValid();
        // yang boleh menghapus cuma admin, buat ngebersihin waktu mapelnya dihapus
        allow delete: if kurikulum();
      }

      // ujian sumatif: pemiliknya + kurikulum; kalau dibagikan,
      // pengampu lain di mapel ini & di grupnya bisa lihat (dan nyalin ke ujiannya sendiri)
      match /sumatif/{id} {
        allow read: if aktif() && (
          kurikulum()
          || resource.data.pemilik == request.auth.uid
          || (resource.data.dibagikan == true && (pengampu(idMapel) || segrup(idMapel))));
        allow create: if aktif()
          && ((request.resource.data.pemilik == request.auth.uid && pengampu(idMapel)) || kurikulum())
          && sumatifValid();
        allow update: if aktif()
          && resource.data.pemilik == request.auth.uid
          && request.resource.data.pemilik == request.auth.uid
          && sumatifValid();
        allow delete: if aktif()
          && (resource.data.pemilik == request.auth.uid || kurikulum());
      }
    }

    // ---------- grup mapel ----------
    // isinya daftar pengampu semua kelas di grup + koordinator UAS.
    // Diperbarui otomatis dari perangkat admin; koordinator dipilih admin.
    match /grup/{idGrup} {
      allow read: if aktif();
      allow write: if kurikulum();

      // UAS bersama satu grup per semester. Disusun koordinator (selama masih draf / diajukan),
      // lalu diperiksa, dikunci, dan dicetak admin. Yang udah dikunci cuma bisa diubah admin.
      match /uas/{id} {
        allow read: if aktif() && (kurikulum() || anggotaGrup(idGrup));
        allow create: if aktif() && (kurikulum()
          || (koordinatorGrup(idGrup) && request.resource.data.status == 'draf' && uasValid()));
        allow update: if aktif() && (kurikulum()
          || (koordinatorGrup(idGrup)
              && resource.data.status in ['draf', 'diajukan']
              && request.resource.data.status in ['draf', 'diajukan']
              && uasValid()));
        allow delete: if aktif() && (kurikulum()
          || (koordinatorGrup(idGrup) && resource.data.status == 'draf'));
      }

      // usulan soal UAS dari pengampu di grup; diterima / ditolak koordinator
      match /usulan/{id} {
        allow read: if aktif() && (kurikulum() || anggotaGrup(idGrup));
        allow create: if aktif()
          && ((anggotaGrup(idGrup) && request.resource.data.pemilik == request.auth.uid) || kurikulum())
          && usulanValid();
        allow update: if aktif()
          && resource.data.pemilik == request.auth.uid
          && request.resource.data.pemilik == request.auth.uid
          && usulanValid();
        allow delete: if aktif() && (
          resource.data.pemilik == request.auth.uid
          || koordinatorGrup(idGrup)
          || kurikulum());
      }
    }
  }
}
