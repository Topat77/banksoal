rules_version = '2';

// =====================================================
//  ATURAN KEAMANAN DATABASE — Bank Soal
//
//  Ditempel di Firebase Console → Firestore Database → Rules → Publish.
//  Aturan ini yang beneran ngunci data: walau orang luar (atau santri)
//  berhasil masuk pakai akun Google, mereka nggak bisa baca apa pun
//  sebelum disetujui admin (TU).
//
//  Salinan aturan ini dalam bentuk JavaScript ada di js/aturan.js
//  (dipakai mode coba). Kalau ngubah di sini, ubah di sana juga.
// =====================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Email Google admin (TU) yang pertama (huruf kecil semua).
    // Sama dengan "adminAwal" di js/konfig.js.
    function emailAdminAwal() {
      return ['topatvanjava@gmail.com'];
    }

    function masuk() {
      return request.auth != null;
    }
    function jalurProfil() {
      return /databases/$(database)/documents/pengguna/$(request.auth.uid);
    }
    function aktif() {
      return masuk() && exists(jalurProfil())
        && get(jalurProfil()).data.peran in ['ustadz', 'kurikulum'];
    }
    function kurikulum() {
      return aktif() && get(jalurProfil()).data.peran == 'kurikulum';
    }
    function pengampu(idMapel) {
      return request.auth.uid in get(/databases/$(database)/documents/mapel/$(idMapel)).data.pengampu;
    }
    // grup = mapel yang sama di jenjang & tingkat yang sama (misal B. Indonesia 7A1, 7A2, 7B1, 7B2)
    function dataGrup(idGrup) {
      return get(/databases/$(database)/documents/grup/$(idGrup)).data;
    }
    function anggotaGrup(idGrup) {
      return request.auth.uid in dataGrup(idGrup).pengampu;
    }
    function koordinatorGrup(idGrup) {
      return dataGrup(idGrup).get('koordinator', null) == request.auth.uid;
    }
    // pengampu kelas lain yang satu grup dengan mapel ini
    function segrup(idMapel) {
      return anggotaGrup(get(/databases/$(database)/documents/mapel/$(idMapel)).data.grup);
    }

    // ---------- akun ----------
    match /pengguna/{uid} {
      allow read: if masuk() && (request.auth.uid == uid || kurikulum());

      // daftar pertama kali: selalu "menunggu", kecuali email admin awal
      allow create: if masuk() && request.auth.uid == uid
        && request.resource.data.email == request.auth.token.email
        && (request.resource.data.peran == 'menunggu'
            || (request.resource.data.peran == 'kurikulum'
                && request.auth.token.email_verified == true
                && request.auth.token.email in emailAdminAwal()));

      // ubah profil sendiri boleh, tapi nggak boleh ngubah peran, email, & sapaan sendiri
      // (sapaan ustadz/ustadzah nentuin kelas putra/putri yang boleh diajar, jadi diatur admin).
      // Admin boleh ngubah akun siapa pun (setujui, tolak, nonaktifkan).
      allow update: if masuk() && (
        (request.auth.uid == uid
          && request.resource.data.peran == resource.data.peran
          && request.resource.data.email == resource.data.email
          && request.resource.data.get('sapaan', null) == resource.data.get('sapaan', null))
        || kurikulum());

      allow delete: if kurikulum();
    }

    // ---------- pengaturan (lembaga: nama & lama ujian; bobot: bobot nilai per jenis mapel) ----------
    match /pengaturan/{id} {
      allow read: if aktif();
      allow write: if kurikulum();
    }

    // ---------- santri ----------
    // semua akun aktif boleh lihat; yang ngisi, ngubah, ngehapus cuma admin
    match /santri/{id} {
      allow read: if aktif();
      allow write: if kurikulum();
    }

    // ---------- mapel ----------
    match /mapel/{idMapel} {
      allow read: if aktif();
      allow write: if kurikulum();

      // modul: pemiliknya + kurikulum selalu bisa lihat;
      // pengampu lain mapel ini, dan pengampu kelas lain di grupnya,
      // bisa lihat kalau modulnya dibagikan
      match /modul/{id} {
        allow read: if aktif() && (
          kurikulum()
          || resource.data.pemilik == request.auth.uid
          || (resource.data.dibagikan == true && (pengampu(idMapel) || segrup(idMapel))));
        allow create: if aktif()
          && request.resource.data.pemilik == request.auth.uid
          && pengampu(idMapel);
        allow update: if aktif()
          && resource.data.pemilik == request.auth.uid
          && request.resource.data.pemilik == request.auth.uid;
        allow delete: if aktif()
          && (resource.data.pemilik == request.auth.uid || kurikulum());
      }

      // lembar nilai satu semester: diisi pengampu mapel ini aja;
      // admin cuma bisa lihat (buat pantauan dan rapor)
      match /nilai/{id} {
        allow read: if aktif() && (kurikulum() || pengampu(idMapel));
        allow create, update: if aktif() && pengampu(idMapel);
        // admin boleh menghapus, buat ngebersihin waktu mapelnya dihapus
        allow delete: if aktif() && (pengampu(idMapel) || kurikulum());
      }

      // ujian sumatif: pemiliknya + kurikulum; kalau dibagikan,
      // pengampu lain di mapel ini & di grupnya bisa lihat (dan nyalin ke ujiannya sendiri)
      match /sumatif/{id} {
        allow read: if aktif() && (
          kurikulum()
          || resource.data.pemilik == request.auth.uid
          || (resource.data.dibagikan == true && (pengampu(idMapel) || segrup(idMapel))));
        allow create: if aktif()
          && request.resource.data.pemilik == request.auth.uid
          && pengampu(idMapel);
        allow update: if aktif()
          && resource.data.pemilik == request.auth.uid
          && request.resource.data.pemilik == request.auth.uid;
        allow delete: if aktif()
          && (resource.data.pemilik == request.auth.uid || kurikulum());
      }
    }

    // ---------- grup mapel ----------
    // isinya daftar pengampu semua kelas di grup + koordinator UAS.
    // Diperbarui otomatis dari perangkat admin; koordinator dipilih admin.
    match /grup/{idGrup} {
      allow read: if aktif();
      allow write: if kurikulum();

      // UAS bersama satu grup per semester. Disusun koordinator (selama masih draf / diajukan),
      // lalu diperiksa, dikunci, dan dicetak admin. Yang udah dikunci cuma bisa diubah admin.
      match /uas/{id} {
        allow read: if aktif() && (kurikulum() || anggotaGrup(idGrup));
        allow create: if aktif() && (kurikulum()
          || (koordinatorGrup(idGrup) && request.resource.data.status == 'draf'));
        allow update: if aktif() && (kurikulum()
          || (koordinatorGrup(idGrup)
              && resource.data.status in ['draf', 'diajukan']
              && request.resource.data.status in ['draf', 'diajukan']));
        allow delete: if aktif() && (kurikulum()
          || (koordinatorGrup(idGrup) && resource.data.status == 'draf'));
      }

      // usulan soal UAS dari pengampu di grup; diterima / ditolak koordinator
      match /usulan/{id} {
        allow read: if aktif() && (kurikulum() || anggotaGrup(idGrup));
        allow create: if aktif() && anggotaGrup(idGrup)
          && request.resource.data.pemilik == request.auth.uid;
        allow update: if aktif()
          && resource.data.pemilik == request.auth.uid
          && request.resource.data.pemilik == request.auth.uid;
        allow delete: if aktif() && (
          resource.data.pemilik == request.auth.uid
          || koordinatorGrup(idGrup)
          || kurikulum());
      }
    }
  }
}
